<?xml version="1.0" encoding="UTF-8"?>
<ExtensionManifest Version="11.0"
                   ExtensionBundleId="com.lamacleaner.ps"
                   ExtensionBundleVersion="1.0.1"
                   ExtensionBundleName="LaMa Cleaner"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <ExtensionList>
        <Extension Id="com.lamacleaner.ps.panel" Version="1.0.1"/>
    </ExtensionList>
    <ExecutionEnvironment>
        <HostList>
            <Host Name="PHXS" Version="[24.0,99.9]"/>
            <Host Name="PHSP" Version="[24.0,99.9]"/>
        </HostList>
        <LocaleList>
            <Locale Code="All"/>
        </LocaleList>
        <RequiredRuntimeList>
            <RequiredRuntime Name="CSXS" Version="11.0"/>
        </RequiredRuntimeList>
    </ExecutionEnvironment>
    <DispatchInfoList>
        <Extension Id="com.lamacleaner.ps.panel">
            <DispatchInfo>
                <Resources>
                    <MainPath>./client/index.html</MainPath>
                    <ScriptPath>./jsx/host.jsx</ScriptPath>
                    <CEFCommandLine>
                        <Parameter>--enable-nodejs</Parameter>
                        <Parameter>--mixed-context</Parameter>
                        <Parameter>--allow-file-access-from-files</Parameter>
                    </CEFCommandLine>
                </Resources>
                <Lifecycle>
                    <AutoVisible>true</AutoVisible>
                </Lifecycle>
                <UI>
                    <Type>Panel</Type>
                    <Menu>LaMa Cleaner</Menu>
                    <Geometry>
                        <Size><Height>540</Height><Width>320</Width></Size>
                        <MinSize><Height>440</Height><Width>280</Width></MinSize>
                        <MaxSize><Height>900</Height><Width>500</Width></MaxSize>
                    </Geometry>
                    <Icons>
                        <Icon Type="Normal">./client/icon.png</Icon>
                        <Icon Type="RollOver">./client/icon.png</Icon>
                        <Icon Type="Disabled">./client/icon.png</Icon>
                        <Icon Type="DarkNormal">./client/icon.png</Icon>
                        <Icon Type="DarkRollOver">./client/icon.png</Icon>
                    </Icons>
                </UI>
            </DispatchInfo>
        </Extension>
    </DispatchInfoList>
</ExtensionManifest>
